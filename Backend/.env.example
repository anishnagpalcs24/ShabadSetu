# ShabadSetu Backend Environment Configuration

PORT=3000
NODE_ENV=development

# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS and Frontend Configuration
# Comma-separated allowed origins (default whitelists https://shabadsetu.vercel.app and localhost)
FRONTEND_URL=https://shabadsetu.vercel.app
CORS_ORIGIN=https://shabadsetu.vercel.app,http://localhost:5173

# Database Pool Max Connections (recommend 5 for Vercel serverless)
DB_POOL_MAX=5

# Gurbani Provider Configuration
GURBANI_PROVIDER=igranth
IGRANTH_BASE_URL=https://api.igranth.net
IGRANTH_API_KEY=

# OTP / Email Configuration (Optional - defaults to console for testing)
OTP_DELIVERY_MODE=console
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
